# Copy this file to .env and fill ONE provider. Never commit .env.
# mock = offline demo, no key needed. Sidebar shows: mock | groq | openrouter | openai
# Also supported: xai | anthropic | gemini
# Cheapest real-LLM route: openrouter with a ':free' model (default). xai = Grok.
LLM_PROVIDER=mock

# Optional: override the default model for the chosen provider
# LLM_MODEL=gpt-4o-mini

GROQ_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# function_calling works on most OpenRouter/xAI models; try json_mode if a model rejects tools
# STRUCTURED_METHOD=function_calling

# Tuning (defaults shown)
LLM_TEMPERATURE=0
MAX_CONCURRENCY=5
MAX_RETRIES=2
# Speed: reviews sent per LLM call (1 = off) and the on-disk result cache
REVIEWS_PER_CALL=8
USE_CACHE=true
BATCH_SIZE=20
MAX_REPORT_REVIEWS=400
